# ==============================================================================
# ShopNET Movies — Production Environment Configuration Template
# ==============================================================================
# IMPORTANT: Never commit actual production secrets to version control.
# Inject these via AWS Secrets Manager, GCP Secret Manager, or HashiCorp Vault.

# ------------------------------------------------------------------------------
# 1. Core Runtime Configuration
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3001
NEXT_PUBLIC_APP_URL=https://movies.shopnet.ai
NEXT_PUBLIC_API_URL=https://api-movies.shopnet.ai

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL 16 High-Availability Cluster)
# ------------------------------------------------------------------------------
# Include connection pool parameters: connection_limit=50, pool_timeout=20
DATABASE_URL=postgresql://shopnet_app_user:REPLACE_WITH_STRONG_DB_PASSWORD@prod-db.internal:5432/shopnet_movies_prod?schema=public&sslmode=require&connection_limit=50&pool_timeout=20
POSTGRES_USER=shopnet_app_user
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
POSTGRES_DB=shopnet_movies_prod

# ------------------------------------------------------------------------------
# 3. Queue & Cache (Redis 7 Enterprise / Cluster)
# ------------------------------------------------------------------------------
REDIS_HOST=prod-redis.internal
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD
REDIS_TLS=true

# ------------------------------------------------------------------------------
# 4. Identity & Authentication (Better Auth)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=REPLACE_WITH_CRYPTOGRAPHICALLY_RANDOM_64_CHAR_STRING
BETTER_AUTH_URL=https://api-movies.shopnet.ai
BETTER_AUTH_TRUSTED_ORIGINS=https://movies.shopnet.ai

# ------------------------------------------------------------------------------
# 5. Media Object Storage & CDN (Cloudflare R2 / AWS S3)
# ------------------------------------------------------------------------------
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY
S3_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_KEY
S3_BUCKET_NAME=shopnet-media-prod
S3_FORCE_PATH_STYLE=false
CDN_BASE_URL=https://media-cdn.shopnet.ai

# ------------------------------------------------------------------------------
# 6. Payment Gateways (Live Production Credentials)
# ------------------------------------------------------------------------------
# Paystack (Africa & NGN Card Processing)
PAYSTACK_SECRET_KEY=sk_live_REPLACE_WITH_PAYSTACK_LIVE_SECRET
PAYSTACK_PUBLIC_KEY=pk_live_REPLACE_WITH_PAYSTACK_LIVE_PUBLIC
PAYSTACK_WEBHOOK_SECRET=REPLACE_WITH_PAYSTACK_WEBHOOK_SECRET

# Stripe (Global USD & International Card Processing)
STRIPE_SECRET_KEY=sk_live_REPLACE_WITH_STRIPE_LIVE_SECRET
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_STRIPE_WEBHOOK_SIGNING_SECRET

# ------------------------------------------------------------------------------
# 7. AI Gateway Providers (Production Tiered API Keys)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSy_REPLACE_WITH_GEMINI_PRODUCTION_KEY
OPENAI_API_KEY=sk-proj-REPLACE_WITH_OPENAI_PRODUCTION_KEY
RUNWAY_API_KEY=rw_live_REPLACE_WITH_RUNWAY_PRODUCTION_KEY
ELEVENLABS_API_KEY=el_live_REPLACE_WITH_ELEVENLABS_PRODUCTION_KEY

# ------------------------------------------------------------------------------
# 8. WAF, Edge Security & Rate Limiting
# ------------------------------------------------------------------------------
# Shared secret verified by WafMiddleware against Cloudflare / CDN header (X-ShopNET-WAF-Secret)
WAF_SHARED_SECRET=REPLACE_WITH_STRONG_RANDOM_WAF_SECRET_KEY
CORS_ALLOWED_ORIGINS=https://movies.shopnet.ai,https://admin-movies.shopnet.ai

# ------------------------------------------------------------------------------
# 9. Structured Logging & Observability
# ------------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.internal:4318

# ------------------------------------------------------------------------------
# 10. Worker Fleet Configuration
# ------------------------------------------------------------------------------
WORKER_CONCURRENCY=5
MEDIA_GENERATION_TIMEOUT_MS=600000
VIDEO_TRANSCODE_TIMEOUT_MS=900000
