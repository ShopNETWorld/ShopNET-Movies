# ==============================================================================
# ShopNET Movies — Environment Configuration Template
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=3001

# Web Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# Database (PostgreSQL)
DATABASE_URL=postgresql://shopnet:shopnet_secret@localhost:5432/shopnet_movies?schema=public

# Queue & Cache (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication (Better Auth)
BETTER_AUTH_SECRET=super_secret_auth_token_at_least_32_characters_long_for_security
BETTER_AUTH_URL=http://localhost:3001

# S3-Compatible Object Storage (MinIO local or AWS / Cloudflare R2)
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=shopnet_minio_admin
S3_SECRET_ACCESS_KEY=shopnet_minio_password
S3_BUCKET_NAME=shopnet-media
S3_FORCE_PATH_STYLE=true

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# AI Provider API Keys (Managed securely; not used in production until approved)
GEMINI_API_KEY=
OPENAI_API_KEY=
RUNWAY_API_KEY=
ELEVENLABS_API_KEY=

# --- Free & Extended AI Video Creation Models (5s to 30s) ---
# Alibaba Cloud DashScope / Qwen Wan2.1 (Free tier quota available: https://dashscope.console.aliyun.com)
DASHSCOPE_API_KEY=
NEXT_PUBLIC_DASHSCOPE_API_KEY=

# ByteDance Seedance 2.5 / BytePlus (Up to 30s single-pass 4K cinema with native audio)
SEEDANCE_API_KEY=
NEXT_PUBLIC_SEEDANCE_API_KEY=

# Kuaishou Kling AI (5s-30s high-motion video, 66 free daily credits: https://klingai.com)
KLING_API_KEY=
NEXT_PUBLIC_KLING_API_KEY=

# MiniMax Hailuo AI (Video-01 6s-30s dynamic cinematic shots: https://hailuoai.video)
MINIMAX_API_KEY=
NEXT_PUBLIC_MINIMAX_API_KEY=

# Hugging Face User Access Token (Free serverless inference for CogVideoX, Wan2.1-1.3B)
HUGGINGFACE_API_TOKEN=
NEXT_PUBLIC_HUGGINGFACE_API_TOKEN=

# Pollinations.ai Free Video Agent (100% Free, no API key or subscription required)
POLLINATIONS_FREE_ENABLED=true

# Payment Gateways (Phase 7)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# WAF & Edge Security (Phase 8)
WAF_SHARED_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001


