# ShopNET Movies - Benchmark Environment Configuration
# Copy this file to .env or set variables in your environment to test live APIs.
# If keys are omitted, the benchmark harness can run in recorded/mock mode.

# Mode: "mock" (default if no keys) or "live"
BENCHMARK_MODE=mock

# Google AI / Vertex API Key (Gemini Omni Flash & Google Veo 3.1)
GEMINI_API_KEY=

# OpenAI API Key (Sora 2 / Sora 2 Pro)
OPENAI_API_KEY=

# Runway Developer API Key (Gen-4 Turbo / Gen-4.5)
RUNWAY_API_KEY=

# Luma Dream Machine API Key (Ray 3.2)
LUMA_API_KEY=

# Pika API Key (Happyhorse 1.0)
PIKA_API_KEY=
