{
  "name": "shopnet-movies",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo clean && rimraf node_modules",
    "benchmark": "pnpm --filter shopnet-provider-benchmark benchmark"
  },
  "devDependencies": {
    "@neon/config": "^1.8.3",
    "@neon/env": "^1.4.8",
    "@shopnet/config-typescript": "workspace:*",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "turbo": "^2.1.2",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "unrs-resolver",
      "msgpackr-extract",
      "esbuild"
    ]
  }
}
